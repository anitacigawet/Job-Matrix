# Job Matrix — local self-hosted configuration
#
# All keys are optional at boot. You can set them here, or save them at
# runtime through the Settings page (which writes to ./data/settings.json).
# Env vars take precedence over the settings file.
#
# Pick ONE active provider — you only need a key for the provider you select.
# Default is Google Gemini.

# Active LLM provider (gemini | openai | deepseek). Settings UI overrides this
# unless an env value is set here.
# LLM_PROVIDER=gemini

# ─── Google Gemini ───────────────────────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── OpenAI ──────────────────────────────────────────────────────
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── DeepSeek ────────────────────────────────────────────────────
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ─── Tier 1 data sources ─────────────────────────────────────────
# Each source is independently optional. When values are set here, env
# overrides Settings → Data Sources. Leave any of them blank to use what
# you save through the UI. Sources with no credentials at all (Remotive,
# RemoteOK, The Muse w/o key) work out of the box with no signup.

# Adzuna — free hobbyist account at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJobs — free key at https://developer.usajobs.gov/APIRequest/
# Both fields required: USAJobs verifies the User-Agent matches the email
# on file for your API key.
USAJOBS_EMAIL=
USAJOBS_API_KEY=

# Jooble — partner key at https://jooble.org/api/about (manual approval)
JOOBLE_API_KEY=

# The Muse — optional; raises rate limit. https://www.themuse.com/developers/api/v2
THEMUSE_API_KEY=

# ─── Storage / server ────────────────────────────────────────────

# Where the SQLite database file lives (auto-created on first run)
DATABASE_PATH=./data/app.db

# Where the user-editable settings JSON file lives
SETTINGS_PATH=./data/settings.json

# Server port
PORT=3000
