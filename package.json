{
  "name": "job-matrix",
  "version": "1.0.0",
  "description": "Local multi-source job search, filtering, fit scoring, and application tracking.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "anitacigawet",
  "repository": {
    "type": "git",
    "url": "https://github.com/anitacigawet/Job-Matrix.git"
  },
  "homepage": "https://jobmatrix.scootsolute.org/",
  "bugs": {
    "url": "https://github.com/anitacigawet/Job-Matrix/issues"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "node scripts/build-client.mjs && node scripts/build-server.mjs && node scripts/copy-runtime-assets.mjs",
    "build:showroom": "cross-env VITE_SHOWROOM_MODE=true vite build",
    "showroom:capture": "node scripts/capture-screenshots.mjs",
    "start": "node scripts/start-production.mjs",
    "release:assemble": "node scripts/build-release.mjs",
    "release:smoke": "node scripts/smoke-release.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@google/genai": "2.15.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "lucide-react": "^0.453.0",
    "next-themes": "^0.4.6",
    "openai": "7.3.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.7",
    "sql.js": "^1.11.0",
    "superjson": "^1.13.3",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.3.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^7.0.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "jsdom": "^29.1.1",
    "playwright": "1.59.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vitest": "3.2.6"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "esbuild": "0.28.1",
      "path-to-regexp@0.1.12": "0.1.13",
      "picomatch": "4.0.4",
      "rollup": "4.59.0",
      "tar": "7.5.21",
      "undici": "7.29.0"
    }
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@10.4.1"
}
